{
  "name": "@local/forgeflow-dsh",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "ForgeFlow state/gate tools, four-layer anchor, archive guard and read-only board panel for DeepSeek Harness",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./register": "./register.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "generate-board.mjs",
    "register.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
