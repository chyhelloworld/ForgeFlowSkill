<mxfile host="app.diagrams.net">
  <diagram id="existing-project-workflow" name="已有项目 只读盘点后选择最短有效路径">
    <mxGraphModel dx="1400" dy="1880" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1880">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="已有项目 只读盘点后选择最短有效路径" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=30;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="20" width="1300" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="先接手，再决定补什么；旧文件存在不代表有效，旧绿灯不代表当前版本通过。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="65" width="1300" height="40" />
        </mxCell>
        <mxCell id="note0" value="恢复检查点：版本/脏状态、已完成与部分产物、运行中操作、阻塞、下一步与权限边界。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1760" width="1300" height="40" />
        </mxCell>
        <mxCell id="note1" value="变更影响分析：仅使受影响规格、票据、测试、审核与用户接受失效；重新验证后继续。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1790" width="1300" height="40" />
        </mxCell>
        <mxCell id="note2" value="ready 不等于授权；PR 不替代规格，不自动合并、部署或发布。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1820" width="1300" height="40" />
        </mxCell>
        <mxCell id="a" value="ff-intake 只读接手或恢复&#10;目标/规格/票据/代码/测试/脏工作区&#10;检查分支、未跟踪文件、运行中任务与环境" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="140" width="660" height="110" />
        </mxCell>
        <mxCell id="b" value="判断材料有效性与下一责任&#10;valid / stale / missing / unknown&#10;保护现有修改；不在 Intake 中写文件" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="330" width="660" height="110" />
        </mxCell>
        <mxCell id="c" value="目标缺失或不清楚&#10;ff-grill&#10;只补关键目标与取舍&#10;然后核对规格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="550" width="300" height="130" />
        </mxCell>
        <mxCell id="d" value="目标清楚，规格缺失/过期&#10;ff-spec&#10;补主流程、边界、验收&#10;需要时 Design / Prove" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="550" width="300" height="130" />
        </mxCell>
        <mxCell id="e" value="规格有效，票据缺失/过期&#10;ff-plan&#10;重排受影响切片与验证&#10;再做独立计划审核" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="715" y="550" width="300" height="130" />
        </mxCell>
        <mxCell id="f" value="规格和票据均有效&#10;复用现有产物&#10;核对审核与证据有效性&#10;不必全流程重跑" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="550" width="300" height="130" />
        </mxCell>
        <mxCell id="g" value="汇合前补齐依赖的缺口&#10;Grill → Spec → Plan，仅运行所需部分&#10;Design / Prove 的结论反馈到规格与计划" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="830" width="660" height="110" />
        </mxCell>
        <mxCell id="h" value="实施就绪与授权核对&#10;独立 plan 审核有效？目标/票据/测试明确？&#10;环境可用？风险与权限明确？&#10;未就绪回到对应责任；未知不冒充通过" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1020" width="660" height="120" />
        </mxCell>
        <mxCell id="i" value="ff-implement 继续最小获准切片&#10;保留他人修改，核对旧操作后再续跑&#10;实现/测试与证据绑定当前版本" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1220" width="660" height="110" />
        </mxCell>
        <mxCell id="j" value="ff-review · goal-mainflow + code&#10;独立验证真实主流程与代码风险&#10;失败修复复验；需求变化回到 Spec/Plan" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1400" width="660" height="110" />
        </mxCell>
