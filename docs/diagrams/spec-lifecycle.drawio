        </mxCell>
        <mxCell id="subtitle" value="0.5.0-rc2 · OpenSpec 原生 FF gate；内容绑定不等于真实性或授权。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="65" width="1300" height="40" />
        </mxCell>
        <mxCell id="note0" value="当前规格看现在；活跃变更看本轮；归档历史只在追溯时按需读取。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1280" width="1300" height="40" />
        </mxCell>
        <mxCell id="note1" value="Handoff 记录真实版本与状态；Intake 只读核对实际结果，再选择下一责任。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1310" width="1300" height="40" />
        </mxCell>
        <mxCell id="note2" value="显式 canceled/rejected 关闭保留原产物；不能用取消归档回滚已生效规格。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1340" width="1300" height="40" />
        </mxCell>
        <mxCell id="a" value="当前有效规格 · 唯一现行承诺&#10;openspec/specs + 稳定需求 ID + 验收标准" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="140" width="660" height="110" />
        </mxCell>
        <mxCell id="b" value="活跃变更 · 尚未生效的差异&#10;changes + delta + artifact ID / 依赖指纹" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="330" width="660" height="110" />
        </mxCell>
        <mxCell id="c" value="instructions apply → 实施与验证&#10;任务与证据绑定路径哈希与依赖指纹&#10;验证通过不自动等于人工接受" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="520" width="660" height="110" />
        </mxCell>
        <mxCell id="d" value="独立 review + 当前版本真实接受&#10;review 绑定目标版本 / 内容 / 依赖&#10;缺失或过期：不允许正常 archive" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="710" width="660" height="110" />
        </mxCell>
        <mxCell id="e" value="validate / 正常 archive 共用 FF gate&#10;策略、文件、依赖和 review 仍有效？&#10;过期或冲突：阻塞并返回 Spec" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="900" width="660" height="110" />
        </mxCell>
        <mxCell id="f" value="archive 正常路径：同步 specs + 移入历史&#10;apply 仅实施指导；通过不等于用户接受&#10;此合入不等于 Git 主分支合并或发布" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2efe8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
