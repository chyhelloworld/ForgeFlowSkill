<mxfile host="app.diagrams.net">
  <diagram id="new-project-workflow" name="新项目 从目标到规格 票据 实施与交付">
    <mxGraphModel dx="1400" dy="2040" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="2040">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="新项目 从目标到规格 票据 实施与交付" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=30;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="20" width="1300" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="九个独立责任接口，按需复用；箭头表示交接语义，不承诺宿主自动调度。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="65" width="1300" height="40" />
        </mxCell>
        <mxCell id="note0" value="轻量小修：允许内联规格和票据，但保留验收、授权、验证与相应独立审核。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1920" width="1300" height="40" />
        </mxCell>
        <mxCell id="note1" value="获准变更只使受影响规格、票据、测试、审核和用户接受失效；未受影响证据可复用。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1950" width="1300" height="40" />
        </mxCell>
        <mxCell id="note2" value="交付不等于自动合并、部署或发布；没有人工反馈时保留“待接受”。" style="text;html=0;align=left;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Noto Sans CJK SC;fontSize=19;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1980" width="1300" height="40" />
        </mxCell>
        <mxCell id="a" value="明确目标、范围与授权&#10;新项目通常从 ff-grill 开始" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="140" width="660" height="90" />
        </mxCell>
        <mxCell id="b" value="ff-grill 澄清用户与成功条件&#10;已有明确确认可复用，不重复盘问" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="290" width="660" height="100" />
        </mxCell>
        <mxCell id="c" value="ff-spec 定义做什么与如何验收&#10;需求、非目标、主流程、边界与验收标准" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="470" width="660" height="110" />
        </mxCell>
        <mxCell id="d" value="ff-design 可选&#10;视觉/交互方向需要选择&#10;候选 → 选择 → 回写规格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="650" width="390" height="110" />
        </mxCell>
        <mxCell id="e" value="ff-prove 可选&#10;技术/真实环境存在关键未知&#10;有界实验 → 证据 → 回写规格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="650" width="390" height="110" />
        </mxCell>
        <mxCell id="f" value="规格与关键未知已就绪？&#10;缺项回到对应责任补齐&#10;无相关未知可跳过两侧环节" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="650" width="460" height="110" />
        </mxCell>
        <mxCell id="g" value="ff-plan 把规格拆成可执行票据&#10;依赖、切片、测试、证据、回滚与验收" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="850" width="660" height="110" />
        </mxCell>
        <mxCell id="h" value="ff-review · plan&#10;独立审查计划覆盖与可执行性&#10;问题回到 Plan 或 Spec，复审后继续" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1030" width="660" height="110" />
        </mxCell>
        <mxCell id="i" value="ff-implement 实施已获准切片&#10;核对 readiness 与权限 → 实现 → 测试&#10;每片保存当前版本的证据和检查点" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1edf5;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1210" width="660" height="110" />
        </mxCell>
        <mxCell id="j" value="ff-review · goal-mainflow + code&#10;独立检查目标/真实主流程及代码风险&#10;缺陷返回 Implement；需求偏移返回 Spec" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1390" width="660" height="110" />
        </mxCell>
        <mxCell id="k" value="证据充分 + 人工接受状态明确&#10;PASS / FAIL / NOT_RUN / BLOCKED / N/A&#10;技术完成、用户接受、交付权限分别记录" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff0d8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1570" width="660" height="110" />
        </mxCell>
        <mxCell id="l" value="ff-deliver 汇总与交付&#10;采用 PR 流程且获准时准备/提交 PR；否则文件交接&#10;PR 是审查载体，不替代规格" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2efe8;strokeColor=#a9bac8;fontFamily=Noto Sans CJK SC;fontSize=20;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="370" y="1750" width="660" height="110" />
        </mxCell>
