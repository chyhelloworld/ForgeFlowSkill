new file mode 100644
--- /dev/null
+++ b/src/core/ff-close.ts
@@ -0,0 +1,198 @@
+import { randomUUID } from 'node:crypto';
+import { constants } from 'node:fs';
+import { type FileHandle, access, lstat, mkdir, open, readdir, realpath, rename, rmdir, unlink } from 'node:fs/promises';
+import path from 'node:path';
+import { formatLocalDate } from '../utils/date.js';
+import { folderStyleNameProblem } from './id.js';
+
+export interface FFCloseOptions {
+  projectRoot: string;
+  changeDir: string;
+  archiveDir: string;
+  changeName: string;
+  disposition: string;
+  reason: string;
+  decisionRef: string;
+}
+export interface FFCloseResult {
+  change: string;
+  archivedAs: string;
+  path: string;
+  specsUpdated: false;
+  disposition: 'canceled' | 'rejected';
+}
+interface ClosePaths { root: string; source: string; archive: string; destination: string; claim: string; receipt: string; archivedAs: string }
+interface OwnedFile { dev: number; ino: number }
+interface OwnedClaim { handle: FileHandle; identity: OwnedFile }
+
+function within(root: string, target: string): boolean {
+  const relative = path.relative(root, target);
+  return relative !== '..' && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative);
+}
+async function present(file: string): Promise<boolean> {
+  try { await lstat(file); return true; } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false;
+    throw error;
+  }
+}
+function validateDecision(options: FFCloseOptions): 'canceled' | 'rejected' {
+  if (options.disposition !== 'canceled' && options.disposition !== 'rejected') throw new Error('FF closure disposition must be canceled or rejected');
+  for (const [label, value] of [['reason', options.reason], ['decisionRef', options.decisionRef]]) {
+    if (typeof value !== 'string' || !value.trim()) throw new Error(`FF closure requires a nonempty ${label}`);
+  }
+  if (/[\\/]/u.test(options.changeName)) throw new Error('FF closure supports flat change names only');
+  const nameProblem = folderStyleNameProblem(options.changeName, 'Change name');
+  if (nameProblem) throw new Error(nameProblem);
+  return options.disposition;
+}
+async function rejectSymlinkComponents(root: string, target: string): Promise<void> {
+  if (!within(root, target)) throw new Error(`FF closure path escapes project: ${target}`);
+  let current = root;
+  for (const component of path.relative(root, target).split(path.sep)) {
+    current = path.join(current, component);
+    if (!(await present(current))) return;
+    if ((await lstat(current)).isSymbolicLink()) throw new Error(`FF closure refuses symlink: ${current}`);
+  }
+}
