+/** Stable plan owns task scope and acceptance. Progress contains exactly the approved IDs. */
+function taskProgress(context: Context, progress: { plan: string; tasks: string }, names: string[]): { total: number; complete: number } {
+  if (!names.includes(progress.plan) || names.includes(progress.tasks)) throw new Error('Progress plan must be fingerprinted; tasks must be separate from artifact scope');
+  const plan = readFileSync(safePath(context, progress.plan), 'utf8');
+  const section = /^## Task plan\r?\n([\s\S]*?)(?=^## |$(?![\s\S]))/m.exec(plan)?.[1];
+  const ids = [...(section ?? '').matchAll(/^- (T[A-Za-z0-9_-]+):[^\r\n]+$/gm)].map(m => m[1]);
+  if (!ids.length || new Set(ids).size !== ids.length) throw new Error('Stable plan requires unique task IDs under ## Task plan');
+  const seen = new Set<string>();
+  let complete = 0;
+  for (const line of readFileSync(safePath(context, progress.tasks), 'utf8').split(/\r?\n/)) {
+    if (!line.trim() || /^#/.test(line)) continue;
+    const match = /^- \[([ xX])\] (T[A-Za-z0-9_-]+)$/.exec(line);
+    if (!match || !ids.includes(match[2]) || seen.has(match[2])) throw new Error('Progress must contain only unique approved task IDs; change scope in the stable plan and re-review');
+    seen.add(match[2]);
+    if (match[1].toLowerCase() === 'x') complete++;
+  }
+  if (seen.size !== ids.length) throw new Error('Progress must include every approved task ID');
+  return { total: ids.length, complete };
+}
+
+/** Evaluate FF freshness and review claims. A passing review is evidence binding, not reviewer authentication. */
+export function evaluateFF(projectRoot: string, changeDir: string): FFResult | undefined {
+  const policyPath = path.resolve(projectRoot, 'openspec/ff-policy.json');
+  if (!pathPresent(policyPath)) {
+    if (!pathPresent(path.resolve(projectRoot, changeDir, 'ff-artifacts.json'))) return undefined;
+    return { valid: false, policyHash: '', schemaHash: '', artifacts: [], reasons: ['FF manifest exists but openspec/ff-policy.json is missing or inaccessible'] };
+  }
+  const result: FFResult = { valid: false, policyHash: '', schemaHash: '', artifacts: [], reasons: [] };
+  try {
+    const root = realpathSync(projectRoot);
+    const context: Context = { root, policyPath: path.resolve(root, 'openspec/ff-policy.json'), manifestPath: path.resolve(root, changeDir, 'ff-artifacts.json') };
+    if (!contained(root, context.manifestPath)) throw new Error('FF manifest must be inside the project');
+    safePath(context, 'openspec/ff-policy.json', true);
+    safePath(context, path.relative(root, context.manifestPath).split(path.sep).join('/'), true);
+    const raw = readFileSync(context.policyPath);
+    result.protocol = object(JSON.parse(raw.toString('utf8')), 'Policy').version as number;
+    context.protocol = result.protocol;
+    result.change = path.basename(path.dirname(context.manifestPath));
+    result.policyHash = sha256(raw);
+    const schemaName = resolveSchemaForChange(path.dirname(context.manifestPath), undefined, root);
+    result.schemaHash = sha256(JSON.stringify(resolveSchema(schemaName, root)));
+    let policies = readPolicy(raw);
+    if (result.protocol === 2) {
+      policies = selectPolicies(policies, result.change!);
+      result.policyHash = sha256(JSON.stringify({ protocol: 2, change: result.change, artifacts: policies }));
+    }
+    result.rules = policies;
+    const names = scopes(context, policies);
+    // Current file fingerprints remain inspectable even when old receipts need migration.
+    result.artifacts = policies.map(policy => currentArtifact(context, policy.id, names.get(policy.id)!));
+    for (const artifact of result.artifacts) {
+      const policy = policies.find(p => p.id === artifact.id)!;
+      artifact.inputs = Object.fromEntries(policy.requires.map(id => [id, result.artifacts.find(a => a.id === id)?.fingerprint ?? '']));
+    }
+    let manifest: JsonObject;
+    try { manifest = loadManifest(context, policies); }
+    catch (error) { result.reasons.push(`Invalid FF receipt: ${errorText(error)}`); return result; }
+    const records = object(manifest.artifacts, 'FF manifest artifacts');
+    for (const id of Object.keys(records)) if (!policies.some(policy => policy.id === id)) result.reasons.push(`Unknown artifact record: ${id}; preserve evidence and explicitly migrate the receipt`);
+    const results = new Map<string, FFArtifactResult>();
+    const byId = new Map(policies.map(policy => [policy.id, policy]));
+    function evaluate(id: string): void {
+      if (results.has(id)) return;
+      const policy = byId.get(id)!;
+      policy.requires.forEach(evaluate);
+      results.set(id, evaluateArtifact(context, policy, names.get(id)!, records, results, manifest.version === result.protocol && (result.protocol === 1 || manifest.change === result.change) && manifest.policyHash === result.policyHash && manifest.schemaHash === result.schemaHash));
+    }
+    policies.forEach(policy => evaluate(policy.id));
+    result.artifacts = policies.map(policy => results.get(policy.id)!);
+    result.valid = result.reasons.length === 0 && result.artifacts.length > 0 && result.artifacts.every(artifact => artifact.state === 'valid');
+    result.reasons.push(...result.artifacts.flatMap(artifact => artifact.reasons.map(reason => `${artifact.id}: ${reason}`)));
+  } catch (error) { result.reasons.push(`Invalid FF configuration: ${errorText(error)}`); }
+  return result;
+}
+
+/** Gate mutation-producing workflows without changing legacy behavior when FF is absent. */
+export function requireFF(projectRoot: string, changeDir: string, complete = false): FFResult | undefined {
+  const result = evaluateFF(projectRoot, changeDir);
+  if (result && !result.valid) throw new Error(`FF validity gate failed: ${result.reasons.join('; ')}`);
+  if (complete && result?.protocol === 2 && !result.artifacts.some(a => a.progress)) throw new Error('FF v2 archive requires a reviewed stable plan and progress mapping');
+  if (complete && result?.artifacts.some(a => a.progress && a.progress.complete !== a.progress.total)) throw new Error('FF archive gate: incomplete tasks; ticks do not prove tests passed');
+  return result;
+}
